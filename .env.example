VITE_APP_NAME="Site Name"
VITE_APP_WEBSITE="site.com"
VITE_APP_EMAIL="example@email.com"
VITE_APP_PHONE="+34 666 666 666"
VITE_APP_ADDRESS="Street Dignissim Magna 53, 08273, Spain"
VITE_APP_TITLE="Próximamente"
VITE_APP_DESCRIPTION="Nuestro sitio web está a punto de lanzarse. Mantente atento para ser de los primeros en descubrir todas las novedades y funcionalidades que hemos preparado para ti."
VITE_APP_SHOW_LOGO=true
VITE_APP_URL_LOGO="/logo.png"

VITE_APP_SOCIAL_INSTAGRAM="https://instagram.com/example"
VITE_APP_SOCIAL_FACEBOOK="https://facebook.com/example"
VITE_APP_SOCIAL_TWITTER="https://x.com/example"

VITE_APP_COLOR="rgb(236 72 153)"
VITE_APP_ACCENT_COLOR="rgb(245 180 15)"
# Optional external call-to-action button (castle template)
# VITE_APP_ACTIVITIES_URL="https://example.com"
# VITE_APP_ACTIVITIES_LABEL="Descubre más actividades"
VITE_APP_SHOW_MAP=true
# Optional: paste the src from Google Maps > Share > Embed a map. Defaults to the address above.
# VITE_APP_MAP_EMBED_URL="https://www.google.com/maps/embed?pb=..."
VITE_APP_TEMPLATE="default" # default, minimal, modern, beauty, parallax, castle